  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Thomas - Timeline
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Thomas - Timeline
  speakerName: 
  lineText: "You select the 'Timeline' baseline.\r\n\r\n<b>Detective Miller:</b>
    \r\n\"Walk me through your timeline for this morning. When did you get the news?\"\r\n\r\n<b>Thomas
    Webb:</b> \r\n\"I was still backstage at the convention hall, holding his damn
    trophy. Yuki called my cell in an absolute panic, crying that the police were
    here. I dropped everything and practically sprinted the whole way to the gallery.
    That's it. That's all I know.\"\r\n\r\n<b>Investigator's Note:</b> His timeline
    matches the sequence of events perfectly. He got the call from Yuki and arrived
    exactly when expected. \r\n\r\n\r\n\r"
