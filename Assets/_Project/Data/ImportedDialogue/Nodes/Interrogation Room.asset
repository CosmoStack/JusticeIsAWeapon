  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Interrogation Room
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Interrogation Room
  speakerName: 
  lineText: "\r\n\r\n<b>Detective Miller:</b>\r\n\"Alright, let's get this roster
    organized. The assistant curator, Yuki, is the one who actually discovered the
    body, though the security chief, Victor, is the one who made the 911 call. There
    was another employee on-site\u2014Leo, the archive assistant\u2014but the kid
    was running on fumes after pulling an all-night digitization shift. I let him
    head home to get some sleep. We'll bring him back in later.\r\n\r\n\"As for the
    rest... the victim's brother, Thomas, just arrived outside the tape, and we called
    the ex-wife, Elena, earlier and had her brought down. They're all waiting. Let's
    see whose story cracks first.\"\r\n\r\n[<b>Detective Miller:</b>\r\n\"You won't
    believe this. A call from forensics just came over and the key you sent for examination...
    it had Elena's fingerprints on it. They said it was fresh and was used recently
    to unlock a door.\r\n\r\n\"We can finally catch her for something.\"\r\n\r\n<b>[CLUE
    COLLECTED: Master Key Fingerprints]</b>\r\n\r\n]Who do you want to interrogate?\r\n\r\n\r\n\r\n\r\n\r\n\r\n<b>Detective
    Miller:</b>\r\n\"That's everyone. And every single one of them is a dead end
    on paper. We aren't getting anything else out of them right now. You have the
    master key. Go back and crack open that Private Office before the city council
    shuts us down.\"\r\n\r\n<b>Detective Miller:</b>\r\n\"We are missing something.
    You need to go back and check the Private Office.\"\r\n\r\n<b>Detective Miller:</b>\r\n\"Detective.
    I have another news for you. Forensics also just called me again. Marcus did
    not ingest the poison. The vial was planted post-mortem, and the fatal blow was
    delivered before the scene was staged. You can now actually use your ability
    on the vase to find out who the killer is.\"\r\n\r\n<b>[ABILITY UNLOCKED: Time
    Vision]</b>\r\n\r\n[Head to the Webb Gallery|Gallery - Restricted]\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
  bodyLanguageOverride: 
  isDeadEnd: 0
  choices:
