--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Interview Elena
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Interview Elena
  speakerName: 
  lineText: "The camera settles on Elena Vance. She sits with perfect posture, checking
    an expensive watch. She is Marcus's ex-wife and a rival gallery owner, but she
    projects the icy, untouchable aura of a corporate CEO who has somewhere much
    better to be.\r\n\r\n<b>DEDUCTION CLIPBOARD ACTIVE</b>\r\n\r\n\r\n\r\n<i>You
    currently have no physical clues to present. Select a baseline topic for Detective
    Miller to press her on.</i>\r\n\r\n\r\n\r\n\r\n<b>Detective Miller:</b>\r\n\"She's
    a fortress. Unless we find a paper trail proving she was in that building last
    night, she's going to walk right out of here to her board meeting.\"\r\n\r\n<i>ELENA
    VANCE'S STATEMENT LOGGED</i>\r\n\r\n\r\n\r\n\r\n\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
  bodyLanguageOverride: 
  isDeadEnd: 0
  choices:
  - choiceLabel: The Restricted Corridor Door
    nextNode: {fileID: 11400000, guid: 12bfc5c9053694840adf854ce9a3c32a, type: 2}
  - choiceLabel: Asset Liquidation Contract
    nextNode: {fileID: 11400000, guid: dc9ae6b46c2cfb94bbf0b7b75b51f321, type: 2}
  - choiceLabel: Master Key Fingerprints
    nextNode: {fileID: 11400000, guid: f58f04f1a2a3b564fa08d40d93f83fa6, type: 2}
  - choiceLabel: Press on Alibi
    nextNode: {fileID: 11400000, guid: 50e47553d3f2c754398b9fefd6394781, type: 2}
  - choiceLabel: Press on Timeline
    nextNode: {fileID: 11400000, guid: 0f83839da1138944886cdba96c36fd48, type: 2}
  - choiceLabel: Press on Relationship to Victim
    nextNode: {fileID: 11400000, guid: f8d156377f807844589528f850b8a1db, type: 2}
  - choiceLabel: Return to the Roster
    nextNode: {fileID: 11400000, guid: 814d63f17eee8284dabb89ebb6d4214b, type: 2}
  - choiceLabel: Step out for now
    nextNode: {fileID: 11400000, guid: 814d63f17eee8284dabb89ebb6d4214b, type: 2}
  blocks:
  - condition: 
    text: 'The camera settles on Elena Vance. She sits with perfect posture, checking
      an expensive watch. She is Marcus''s ex-wife and a rival gallery owner, but
      she projects the icy, untouchable aura of a corporate CEO who has somewhere
      much better to be.

      

      <b>DEDUCTION CLIPBOARD ACTIVE</b>

'
    links: []
  - condition: (history:) contains "The Restricted Corridor Door" and (history:)
      does not contain "Miller - Key Handoff"
    text: '

'
    links:
    - label: The Restricted Corridor Door
      target: Miller - Key Handoff
      node: {fileID: 11400000, guid: 12bfc5c9053694840adf854ce9a3c32a, type: 2}
  - condition: (history:)contains"Contract Clue Unlock" and (history:)does not contain"Elena
      - Contract" and not ((history:) contains "The Restricted Corridor Door" and
