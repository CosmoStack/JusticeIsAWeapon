    - label: Asset Liquidation Contract
      target: Elena - Contract
      node: {fileID: 11400000, guid: dc9ae6b46c2cfb94bbf0b7b75b51f321, type: 2}
  - condition: (history:)contains"Key Clue Unlock" and _interrogationAfterClue and
      (history:) does not contain "Elena - Key" and not ((history:) contains "The
      Restricted Corridor Door" and (history:) does not contain "Miller - Key Handoff")
