  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Yuki - Timeline
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Yuki - Timeline
  speakerName: 
  lineText: "You select the 'Timeline' baseline. \r\n\r\n\r\n<b>Detective Miller:</b>
    \r\n\"Victor claims you came to his security desk panicking around 7:35 AM. Take
    me through exactly what happened this morning.\"\r\n\r\n<b>Yuki Tanaka:</b> \r\n\"I
    arrived at 7:30 AM to start my shift. I went to Marcus's office to drop off some
    paperwork, but the door was locked and he wasn't answering. That wasn't like
    him. I got Victor to override the lock, and we found him together.\"\r\n\r\n''[Investigator's
    Note:]'' Her timeline lines up perfectly with Victor's down to the minute, and
    she uses him to validate her sequence of events. It's a solid, verifiable story.\r\n\r\n<b>Detective
    Miller:</b> \r\n\"Take me through the exact timeline of when you found him this
    morning.\"\r\n\r\n<b>Yuki Tanaka:</b> \r\n\"I arrived at 7:30 AM to start my
    shift. I went to his office to drop off some paperwork, but the door was locked
    and he wasn't answering. That wasn't like him. I got Victor to override the lock,
    and we found him together.\"\r\n\r\n''[Investigator's Note:]'' She immediately
    involves the Security Chief in her timeline to validate her story. It's a solid
    sequence of events for the morning, assuming Victor backs it up.\r\n\r\n\r\n"
  category: 0
