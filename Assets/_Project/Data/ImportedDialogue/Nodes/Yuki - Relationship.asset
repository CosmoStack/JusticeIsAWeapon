  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Yuki - Relationship
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Yuki - Relationship
  speakerName: 
  lineText: "<i>You selected the 'Relationship' baseline.</i>\r\n\r\n<b>Detective
    Miller:</b> \r\n\"Walk me through your dynamic with Marcus. You were his assistant
    curator. Was there any tension between you two?\"\r\n\r\n<b>Yuki Tanaka:</b>
    \r\n\"Strictly professional. Marcus was highly demanding, especially with the
    gala approaching. We were all under immense pressure to ensure everything was
    perfect, but that was just the nature of the job.\"\r\n\r\n''[Investigator's
    Note:]'' She's keeping it strictly about the work. It's a standard, careful answer.
    There's no visible friction to press her on without something tangible to contradict
    her.\r\n\r\n\r\n\r"
