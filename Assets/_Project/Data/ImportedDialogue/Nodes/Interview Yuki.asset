  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Interview Yuki
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Interview Yuki
  speakerName: 
  lineText: "The camera settles on Yuki Tanaka across a plain, metal table. She sits
    perfectly straight, her hands folded neatly in front of her, the picture of a
    professional holding it together after a shock.\r\n\r\n<b>DEDUCTION CLIPBOARD
    ACTIVE</b>\r\n<i>PHYSICAL EVIDENCE</i>\r\n\r\n\r\n\r\n<i>You currently have no
    physical clues to present. Select a baseline topic for Detective Miller to press
    her on.</i>\r\n\r\n\r\n\r\n\r\n<b>Detective Miller:</b>\r\n\"Her story is ironclad.
    We aren't getting anything else out of her without physical proof.\"\r\n\r\n<i>YUKI
    TANAKA'S STATEMENT LOGGED</i>\r\n\r\n\r\n\r\n\r\n\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
  bodyLanguageOverride: 
  isDeadEnd: 0
