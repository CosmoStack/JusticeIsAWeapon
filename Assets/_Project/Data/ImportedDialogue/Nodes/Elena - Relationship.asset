  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Elena - Relationship
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Elena - Relationship
  speakerName: 
  lineText: "You tap the 'Relationship' baseline on your clipboard. Miller sits up
    slightly straighter to match her corporate energy.\r\n\r\n<b>Detective Miller:</b>
    \r\n\"Let's talk about you and Marcus. Ex-spouses running rival galleries in
    the same city... there had to be friction.\"\r\n\r\n<b>Elena Vance:</b> \r\n\"It
    is a devastating loss for the art community. Marcus and I had a perfectly fine
    working relationship. My statements regarding the gallery's portfolio are on
    file with Detective Miller. If you'll excuse me, I have a board meeting to salvage.\"\r\n\r\n''[Investigator's
    Note:]'' There is a total lack of humanity in her response. She's already treating
    her ex-husband's death as a logistical problem to manage.\r\n \r\n\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
