      target: Case File
      node: {fileID: 11400000, guid: 8a07368a5cfc1cf42a94192573e4e01e, type: 2}
  - condition: (history:)contains"Elena - Key"
    text: ' | '
    links:
    - label: Use Time Vision
      target: Gallery Exterior Time Vision
      node: {fileID: 11400000, guid: 2bd6b2656707d954395bda9b9e855d52, type: 2}
  - condition: 
    text: "\r\n\r\nA modern art gallery exterior at night. Noir aesthetic, cold blue
      and deep gray color palette. Wide double glass doors face a concrete front
      plaza; a public sidewalk runs along the front. The building is boxed in by
      tall, imposing city structures on both sides. Rain-slicked pavement reflecting
      streetlight, moody cinematic lighting, highly detailed comic art style. Large
      floor-to-ceiling glass windows, a glowing minimalist sign reading \"Webb Gallery.\"
      Yellow police tape stretched across the entrance. Gloomy, atmospheric, no characters
      visible \u2014 background plate only.\r\n\r\n"
    links: []
  - condition: (history:)does not contain"The Restricted Corridor Door"
    text: '<b>Detective Miller:</b>

      "Head inside and investigate the gallery.
      I''ll question some locals for now."'
    links: []
  - condition: (history:)does not contain"Interrogation Room" and not ((history:)does
      not contain"The Restricted Corridor Door")
    text: '<b>Detective Miller:</b>

      "I was able to gather a few witnesses.
      We should go and interrogate them."'
    links: []
  - condition: (history:)does not contain"Contract Clue Unlock" and not ((history:)does
      not contain"The Restricted Corridor Door") and not ((history:)does not contain"Interrogation
      Room")
    text: '<b>Detective Miller:</b>

      "Found anything interesting to interrogate
      them again?"'
    links: []
  - condition: (history:)does not contain"Elena - Contract" and not ((history:)does
      not contain"The Restricted Corridor Door") and not ((history:)does not contain"Interrogation
      Room") and not ((history:)does not contain"Contract Clue Unlock")
    text: '<b>Detective Miller:</b>

      "Contract to liquidate assets? Let''s
      head back for some more interrogation."'
    links: []
  - condition: (history:)does not contain"Key Clue Unlock" and not ((history:)does
      not contain"The Restricted Corridor Door") and not ((history:)does not contain"Interrogation
      Room") and not ((history:)does not contain"Contract Clue Unlock") and not ((history:)does
      not contain"Elena - Contract")
    text: '<b>Detective Miller:</b>

      "Found anything interesting to interrogate
      them again?"'
    links: []
  - condition: (history:)does not contain"Elena - Key" and not _keyFirst and not
      ((history:)does not contain"The Restricted Corridor Door") and not ((history:)does
      not contain"Interrogation Room") and not ((history:)does not contain"Contract
      Clue Unlock") and not ((history:)does not contain"Elena - Contract") and not
      ((history:)does not contain"Key Clue Unlock")
    text: '<b>Detective Miller:</b>

      "You won''t believe this. A call from
      forensics just came over and the key you sent for examination... it had Elena''s
      fingerprints on it. They said it was fresh and was used recently to unlock
      a door.

      

      "We can finally catch her for something."

      

      <b>[CLUE
      COLLECTED: Master Key Fingerprints]</b>'
    links: []
  - condition: 
    text: '

      

'
