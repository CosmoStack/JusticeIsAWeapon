  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Gallery Exterior
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Gallery Exterior
  speakerName: 
  lineText: " | \r\n\r\nA modern art gallery exterior at night. Noir aesthetic, cold
    blue and deep gray color palette. Wide double glass doors face a concrete front
    plaza; a public sidewalk runs along the front. The building is boxed in by tall,
    imposing city structures on both sides. Rain-slicked pavement reflecting streetlight,
    moody cinematic lighting, highly detailed comic art style. Large floor-to-ceiling
    glass windows, a glowing minimalist sign reading \"Webb Gallery.\" Yellow police
    tape stretched across the entrance. Gloomy, atmospheric, no characters visible
    \u2014 background plate only.\r\n\r\n<b>Detective Miller:</b>\r\n\"Head inside
    and investigate the gallery. I'll question some locals for now.\"<b>Detective
    Miller:</b>\r\n\"I was able to gather a few witnesses. We should go and interrogate
    them.\"<b>Detective Miller:</b>\r\n\"Found anything interesting to interrogate
    them again?\"<b>Detective Miller:</b>\r\n\"Contract to liquidate assets? Let's
    head back for some more interrogation.\"<b>Detective Miller:</b>\r\n\"Found anything
    interesting to interrogate them again?\"<b>Detective Miller:</b>\r\n\"You won't
    believe this. A call from forensics just came over and the key you sent for examination...
    it had Elena's fingerprints on it. They said it was fresh and was used recently
    to unlock a door.\r\n\r\n\"We can finally catch her for something.\"\r\n\r\n<b>[CLUE
    COLLECTED: Master Key Fingerprints]</b>\r\n\r\n\r\n\r\n\r\n\r"
