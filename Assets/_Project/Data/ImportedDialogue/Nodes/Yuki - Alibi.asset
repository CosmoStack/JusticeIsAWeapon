  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Yuki - Alibi
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Yuki - Alibi
  speakerName: 
  lineText: "<i>You selected the 'Alibi' baseline.</i>\r\n\r\n<b>Detective Miller:</b>
    \r\n\"Where were you when the incident occurred last night?\"\r\n\r\n<b>Yuki
    Tanaka:</b> \r\n\"I wasn't here. I was supposed to work late on the gala files,
    but around 5 o'clock, Marcus told me to go home and get some rest. I left the
    gallery and went straight to my apartment.\"\r\n\r\n''[Investigator's Note:]''
    If Marcus sent her home, it creates a perfectly clean break in her timeline.
    Without security logs or a witness to prove she came back to the gallery later
    that night, this alibi is a dead end.\r\n\r\n\r\n\r"
  category: 0
