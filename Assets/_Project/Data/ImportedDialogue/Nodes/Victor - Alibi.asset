  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Victor - Alibi
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Victor - Alibi
  speakerName: 
  lineText: "You select the 'Alibi' baseline.\r\n\r\n<b>Detective Miller:</b> \r\n\"Where
    were you last night when the gallery was locked down?\"\r\n\r\n<b>Victor Hasting:</b>
    \r\n\"At home, off shift. Damian Cross, my night guard, was on duty. He ran his
    sweeps and checked the physical locks right on schedule. Nobody went in, nobody
    came out. My system didn't fail.\"\r\n\r\n''[Investigator's Note:]'' He blindly
    trusts his subordinate's report to protect his own system's integrity. Without
    getting our hands on those security logs or speaking to Damian directly, this
    defense is a brick wall.\r\n\r\n\r\n\r"
