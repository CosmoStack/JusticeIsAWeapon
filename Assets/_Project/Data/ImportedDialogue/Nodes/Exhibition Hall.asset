  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Exhibition Hall
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Exhibition Hall
  speakerName: 
  lineText: " | \r\n\r\n\r\n\r\nDucking under the tape together, you enter a space
    designed to be a pristine showroom.\r\n\r\nPristine white marble/hardwood floor,
    harsh track lighting casting long shadows. Empty and near-empty display pedestals
    with faint dust outlines where sculptures once stood, blank stretches of wall
    where paintings were removed. Scattered police evidence markers on the floor.
    A reception desk near the entrance with discarded half-full champagne flutes
    and glossy gala pamphlets. Cold blue-gray palette, single muted crimson accent
    , rain visible through floor-to-ceiling windows. Sterile, tomb-like atmosphere,
    highly detailed comic/graphic-novel art style.\r\n\r\nWhat do you want to inspect?\r\n\r\n\r\n\r\n\r\n[The
    Restricted Corridor Door]\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
  bodyLanguageOverride: 
  isDeadEnd: 0
