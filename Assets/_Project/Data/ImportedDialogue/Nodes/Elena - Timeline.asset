  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Elena - Timeline
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Elena - Timeline
  speakerName: 
  lineText: "You select the 'Timeline' baseline. \r\n\r\n<b>Detective Miller:</b>
    \r\n\"When did you find out about the incident this morning?\"\r\n\r\n<b>Elena
    Vance:</b> \r\n\"Your precinct called my office at 8:00 AM as a primary stakeholder
    in the Webb estate. I cancelled a very important morning briefing to come down
    here and cooperate out of respect for Marcus. But my patience, and my schedule,
    are wearing extremely thin.\"\r\n\r\n<b>Investigator's Note:</b> She frames her
    presence here as a favor to the police rather than an obligation. She is controlling
    the pace of the interview and giving us absolutely nothing to work with.\r\n\r\n\r\n\r"
  category: 0
