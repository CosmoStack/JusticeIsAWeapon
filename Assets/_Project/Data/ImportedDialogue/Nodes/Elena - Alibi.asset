  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Elena - Alibi
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Elena - Alibi
  speakerName: 
  lineText: "You select the 'Alibi' baseline.\r\n\r\n<b>Detective Miller:</b> \r\n\"Where
    were you last night when the gallery was locked down?\"\r\n\r\n<b>Elena Vance:</b>
    \r\n\"I was working late at my own gallery across town, finalizing auction logistics,
    and then I went home. You are welcome to pull my building's security logs. I
    haven't set foot in Marcus's office all week.\"\r\n\r\n''[Investigator's Note:]''
    She offers up her own security logs without blinking. It's a confident, perfectly
    practiced deflection. Unless we find physical evidence putting her inside Marcus's
    gallery last night, we can't touch her.\r\n\r\n\r\n\r"
