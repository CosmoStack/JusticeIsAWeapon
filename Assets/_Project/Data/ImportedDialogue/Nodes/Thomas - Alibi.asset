  m_Script: {fileID: 11500000, guid: 5cf27982398fffe4696d893c8d8f58e5, type: 3}
  m_Name: Thomas - Alibi
  m_EditorClassIdentifier: Assembly-CSharp::JusticeIsAWeapon.Data.DialogueNodeSO
  nodeId: Thomas - Alibi
  speakerName: 
  lineText: "You select the 'Alibi' baseline. Miller keeps his voice level, contrasting
    Thomas's erratic energy.\r\n\r\n<b>Detective Miller:</b> \r\n\"Where were you
    last night when the gallery was locked down?\"\r\n\r\n<b>Thomas Webb:</b> \r\n\"My
    brother is dead on the floor, and you're asking where I was? I was at the gala
    \u2014 accepting a prize he should have been there to take himself. Call the
    entire convention hall; they all watched me on that stage. Do your job and find
    out who actually did this instead of harassing his family.\"\r\n\r\n''[Investigator's
    Note:]'' It's a completely ironclad public alibi. Hundreds of high-society witnesses
    saw him on that stage. We can't touch his whereabouts for the time of the murder.\r\n\r\n\r\n\r"
  category: 0
  requiredClue: {fileID: 0}
  clueRevealed: {fileID: 0}
